<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"> <!-- Deep black background -->

    <!-- The Main Dashboard UI Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/animated_login_card"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:cardBackgroundColor="#16161A"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Premium App Branding Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZALITH MOBILE"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Offline/Cracked Account Text Entry -->
            <EditText
                android:id="@+id/cracked_username_input"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Enter Offline Username"
                android:textColorHint="#52525B"
                android:textColor="#FFFFFF"
                android:background="#222227"
                android:paddingLeft="18dp"
                android:layout_marginBottom="16dp"
                android:singleLine="true"/>

            <!-- Animated Deploy/Launch Button -->
            <Button
                android:id="@+id/btn_launch_game"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="DEPLOY ENGINE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="#2563EB" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
